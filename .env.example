# ===== 数据库（本地 MySQL） =====
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交
DB_USERNAME=root
DB_PASSWORD=请填入你的MySQL密码

# ===== DeepSeek API =====
DEEPSEEK_API_KEY=请填入你的API密钥
# 模型 ID 以 API 账号权限为准（deepseek-v4-pro / deepseek-flash），D1 验证后确定
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== JWT（本地开发可不填，使用默认开发密钥；生产必须设置） =====
# JWT_SECRET=请填入至少32字符的随机字符串

# ⚠️ 安全红线：本文件只允许占位符！
# 真实密钥只能写入 .env（已被 gitignore），任何情况下都不要把真实值提交进仓库。
# 若误提交：立即在对应平台重置密钥，并通知全员。
