# ===== 数据库（本地 MySQL） =====
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 排除，禁止提交
DB_USERNAME=root
DB_PASSWORD=请填入你的MySQL密码

# ===== DeepSeek API =====
DEEPSEEK_API_KEY=请填入你的API密钥
# 模型 ID 以 API 账号权限为准（deepseek-v4-pro / deepseek-flash），D1 验证后确定
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
